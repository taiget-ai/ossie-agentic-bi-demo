# Only required for --mode llm (OpenAI API).
OPENAI_API_KEY=
OSSIE_LLM_MODEL=gpt-4o-mini
# Optional custom OpenAI-compatible endpoint and service-side token.
# Web UI can also override URL/model/token per request; tokens are not persisted.
OSSIE_LLM_BASE_URL=
OSSIE_LLM_API_KEY=

# DuckDB is the default warehouse; SQLite is available for offline tests.
OSSIE_DB_BACKEND=duckdb
OSSIE_DB_PATH=./data/gaming.duckdb
OSSIE_MODEL_PATH=./models/gaming.yaml
